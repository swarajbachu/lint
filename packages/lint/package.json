{
  "name": "@shadcn/lint",
  "version": "0.1.0",
  "description": "A programmable agent-first linter for Tailwind design systems.",
  "license": "MIT",
  "author": {
    "name": "shadcn",
    "url": "https://twitter.com/shadcn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadcn-ui/lint.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/shadcn-ui/lint#readme",
  "bugs": {
    "url": "https://github.com/shadcn-ui/lint/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/tailwind-worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "shadcn-lint": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/postbuild.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node -e \"const fs=require('fs');fs.rmSync('README.md',{force:true});fs.rmSync('LICENSE',{force:true})\""
  },
  "keywords": [
    "shadcn",
    "lint",
    "eslint",
    "oxlint",
    "biome",
    "tailwind",
    "tailwindcss",
    "design-system",
    "cn"
  ],
  "dependencies": {
    "cn": "0.2.6",
    "jiti": "^2.6.1",
    "oxc-parser": "^0.148.0",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@eslint/core": "^0.17.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "oxlint": "^1.80.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
